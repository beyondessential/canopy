#!/bin/sh
set -eu
. "$RIG_RECIPE_DIR/lib.sh"
cd "$RIG_SOURCE"

# Where the file system cannot clone, the manager links target to the dependency
# build, which every build of this lockfile shares. Cargo would then take another
# commit's workspace crates as fresh while that commit's source is still on disk,
# so this build compiles into a copy of its own.
if [ -L target ]; then
  shared=$(cd target && pwd -P)
  rm target
  cp -R -p "$shared" target
fi

(cd private-web && npm run build)
cargo build --locked --bin private-server --bin migrate --bin seed
