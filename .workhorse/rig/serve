#!/bin/sh
set -eu
. "$RIG_RECIPE_DIR/lib.sh"

# The servers refuse PORT and BIND_ADDRESS together, and the rig sets PORT.
unset PORT

# Everything a real instance reaches outside itself, stood in for.
export_fake_deps
export RO_DATABASE_URL="$DATABASE_URL"
export SERVER_VERSIONS_SECRET=rig
export PUBLIC_URL="$RIG_BASE_URL/public"
export META_LOG="${META_LOG:-private_server=info,warn}"

server="$RIG_SOURCE/target/debug/private-server"
headers_port=$(free_port)

trap 'kill $(jobs -p) 2>/dev/null || true; wait' EXIT
CANOPY_TRUST_TAILSCALE_HEADERS=1 BIND_ADDRESS="127.0.0.1:$headers_port" "$server" &
wait_for "the header-trusting server" "http://127.0.0.1:$headers_port/healthz"

cert=$(node -e 'process.stdout.write(encodeURIComponent(require("node:fs").readFileSync(process.argv[1], "utf8")))' "$RIG_OUT/device.pem")
cat > "$RIG_INFO_FILE" <<JSON
{
  "headerAuthUrl": "http://127.0.0.1:$headers_port",
  "deviceId": "$(cat "$RIG_OUT/device-id")",
  "deviceCertificateHeader": "mtls-certificate: $cert",
  "deviceCertificateFile": "$RIG_OUT/device.pem"
}
JSON

BIND_ADDRESS="$RIG_HOST:$RIG_PORT" "$server"
