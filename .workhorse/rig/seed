#!/bin/sh
set -eu
. "$RIG_RECIPE_DIR/lib.sh"

"$(bin migrate)"
"$(bin seed)"

# The seeder gives devices placeholder keys. Swap the first one's (the device
# behind Suva Facility) for a real certificate's, so the device API can be
# driven as it.
mkdir -p "$RIG_OUT"
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 \
  -subj "/CN=canopy-rig-device" -keyout "$RIG_OUT/device.key" -out "$RIG_OUT/device.pem" 2>/dev/null
spki=$(openssl x509 -in "$RIG_OUT/device.pem" -noout -pubkey | openssl pkey -pubin -outform DER | od -An -v -tx1 | tr -d ' \n')
device=$(psql "$RIG_DATABASE_URL" -v ON_ERROR_STOP=1 -qtA -c "
  UPDATE device_keys SET key_data = decode('$spki', 'hex')
  WHERE key_data = decode('30593013' || repeat('10', 60), 'hex')
  RETURNING device_id")
[ -n "$device" ] || { echo "seed: the seeder's first device key was not found" >&2; exit 1; }
printf '%s' "$device" > "$RIG_OUT/device-id"
