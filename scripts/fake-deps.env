# What stands in for everything a Canopy instance reaches outside itself, so a
# real private-server binary can be driven with no AWS, Kubernetes, Tailscale
# control plane or Slack behind it. Read by the e2e fixture
# (private-web/e2e/fixture.ts) and by the rig's serve step (.workhorse/rig/serve),
# which is what keeps the two from drifting apart.
#
# Only what is the same wherever the binary runs belongs here. Anything a run
# decides for itself (the database, the address to bind, the public URL) is set
# by whoever spawns the server.
#
# One KEY=value a line. The value is taken literally to the end of the line:
# no quoting, no escapes, no expansion.

# No cluster: the in-memory backup Secret store, so onboarding (Secret
# creation) works against the real binary.
CANOPY_BACKUP_SECRETS_MEMORY=1

# No AWS: the fake bucket prober. Wizard state is derived from the bucket name
# (…existing… -> kopia repo, …other… -> other content, …denied… ->
# inaccessible, else empty).
CANOPY_BACKUP_PROBER_FAKE=1

# No bucket: uploaded artifacts are held in the server's own process, so
# registering and serving one is exercised end to end.
CANOPY_ARTIFACT_STORE_MEMORY=1

# The in-process fake ACME authority: advertises profiles and accepts
# revocations, so the certificate UI is exercisable without a network.
# Debug-only in the binary.
CANOPY_FAKE_ACME=1

# A throwaway age recipient (bestool-generated) so the recovery vault ceremony
# page reports as configured. The matching private key isn't needed: status,
# challenge and wrong-answer are what is exercised here, and the full decrypt
# round-trip is covered by the Rust endpoint tests.
CANOPY_RECOVERY_VAULT_KEYS=age1uy3nqmdxf4lc3sc4p32c2cp9dlqwk868gjh002gysullrgvp0cjsdg03dn

# Two managed DNS zones so the group-domains UI has something to claim into;
# the nested one is there for the longest-apex-wins case.
CANOPY_DNS_ZONES=tamanu.app=Z1FAKE, demo.tamanu.app=Z2FAKE

# An identity provider issuer with two keys, so its settings and the grant
# choices on a machine's edit page are offered. Nothing signs here: the keys'
# states come from what is seeded.
CANOPY_IDENTITY_ISSUER=https://identity.fake.invalid
CANOPY_IDENTITY_KEYS=key-old, key-new

# The binary defaults to RightmostXForwardedFor for production (behind the
# Tailscale K8s Operator's ingress). With no proxy in front, the
# axum-client-ip middleware would reject every request for a missing
# X-Forwarded-For, so fall back to the raw TCP peer.
CLIENT_IP_SOURCE=ConnectInfo
